<Window x:Class="TinyRightClick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tiny Right Click"
        Width="520" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Modern rounded button style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDimBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDimBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDimBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="36,24,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Status -->
            <RowDefinition Height="Auto"/>  <!-- API Key -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
            <RowDefinition Height="*"/>     <!-- Spacer -->
            <RowDefinition Height="Auto"/>  <!-- Info -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
            <Image Source="icon.png" Width="56" Height="56" Margin="0,0,18,0">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                </Image.Effect>
            </Image>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Tiny Right Click" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Compress images from your right-click menu" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Status Badge -->
        <Border Grid.Row="1" x:Name="StatusBadge"
                HorizontalAlignment="Left" Margin="0,0,0,22"
                CornerRadius="20" Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- API Key Section -->
        <StackPanel Grid.Row="2" Margin="0,0,0,22">
            <TextBlock Text="T I N I F Y   A P I   K E Y" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Password mode (default) -->
                <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Column="0"
                             Style="{StaticResource ModernPasswordBox}"
                             PasswordChanged="ApiKeyPasswordBox_PasswordChanged"/>

                <!-- Plain text mode (toggled) -->
                <TextBox x:Name="ApiKeyTextBox" Grid.Column="0"
                         Style="{StaticResource ModernTextBox}"
                         Visibility="Collapsed"
                         TextChanged="ApiKeyTextBox_TextChanged"/>

                <Button x:Name="ToggleKeyBtn" Grid.Column="1" Margin="8,0,0,0"
                        Style="{StaticResource IconButton}"
                        Click="ToggleKeyVisibility_Click"
                        ToolTip="Show/Hide">
                    <TextBlock x:Name="EyeIcon" Text="👁" FontSize="16"/>
                </Button>

                <Button Grid.Column="2" Margin="8,0,0,0"
                        Height="40" Padding="18,0"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource AccentBrush}"
                        Click="SaveApiKey_Click"
                        Content="Save"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Get your free API key at "/>
                    <Hyperlink x:Name="TinifyLink" Click="TinifyLink_Click"
                               Foreground="{StaticResource AccentBrush}" TextDecorations="None">
                        tinypng.com/developers
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text=" — 500 free compressions/month" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="InstallBtn" Grid.Column="0"
                    Style="{StaticResource ModernButton}"
                    Click="Install_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6C63FF" Offset="0"/>
                        <GradientStop Color="#5A4FCF" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬇" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Install Context Menu" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="UninstallBtn" Grid.Column="2"
                    Style="{StaticResource ModernButton}"
                    Click="Uninstall_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E53935" Offset="0"/>
                        <GradientStop Color="#C62828" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Uninstall" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Toast -->
        <Border Grid.Row="3" x:Name="ToastBorder"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,-50" CornerRadius="10" Padding="24,12"
                Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontSize="13" FontWeight="Medium" Foreground="White"/>
        </Border>

        <!-- Info Footer -->
        <Border Grid.Row="5" CornerRadius="10" Padding="18,14"
                Background="#0A6C63FF" BorderBrush="#1E6C63FF" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                       LineHeight="20">
                <Run Text="Right-click any image file (PNG, JPG, WEBP) and select"/>
                <Run Text="&quot;TinyRC&quot;" FontWeight="SemiBold" Foreground="#B0B0D0"/>
                <Run Text="to compress it. Works with multiple selected files."/>
            </TextBlock>
        </Border>
    </Grid>
</Window>
