<Application x:Class="TinyRightClick.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Color Palette -->
        <Color x:Key="BgDark">#FF1A1A2E</Color>
        <Color x:Key="BgCard">#FF16163A</Color>
        <Color x:Key="BorderDim">#FF2A2A4A</Color>
        <Color x:Key="Accent">#FF6C63FF</Color>
        <Color x:Key="AccentHover">#FF5A52E0</Color>
        <Color x:Key="Danger">#FFE53935</Color>
        <Color x:Key="DangerHover">#FFC62828</Color>
        <Color x:Key="Success">#FF4CAF50</Color>
        <Color x:Key="Warning">#FFFF9800</Color>
        <Color x:Key="TextPrimary">#FFE0E0E0</Color>
        <Color x:Key="TextSecondary">#FF8888A8</Color>
        <Color x:Key="TextDim">#FF555578</Color>

        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}" />
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}" />
        <SolidColorBrush x:Key="BorderDimBrush" Color="{StaticResource BorderDim}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHover}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}" />
    </Application.Resources>
</Application>
